# Optional smoke test only: runs refgrid.exe under Wine to exercise the program's logic before a real capture.
# Wine is not Windows 95. Images from this container are named wine-smoke-* and are evidence of nothing but
# "the program starts, draws three sheets and writes its report".
#
# 32-bit x86 userland; on Apple Silicon Docker runs it under emulation, slowly.
FROM --platform=linux/386 debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

ARG DEBIAN_SNAPSHOT=20261101T000000Z
RUN printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.gpg\n' "$DEBIAN_SNAPSHOT" > /etc/apt/sources.list.d/debian.sources \
 && apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Retries=5 update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      wine wine32 xvfb xdotool x11-apps netpbm nodejs \
 && rm -rf /var/lib/apt/lists/*
ENV WINEDEBUG=-all WINEPREFIX=/tmp/wineprefix DISPLAY=:9
WORKDIR /work
