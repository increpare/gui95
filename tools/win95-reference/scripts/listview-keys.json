  {"click": {"cell": "listview_report", "fx": 0.5, "fy": 0.9}, "note": "click the empty space"},
  {"focus": "listview_icon"},
  {"key": "right"},
  {"key": "right"},
  {"key": "right", "note": "at the end"},
  {"key": "left"},
  {"key": "down"},
  {"key": "home"},
  {"key": "end"},
  {"dblclick": {"cell": "listview_icon", "part": "icon1"}, "note": "double-click an icon"}
 ]
